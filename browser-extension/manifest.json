{
  "manifest_version": 3,
  "name": "Conference Calendar Helper",
  "version": "1.0.0",
  "description": "Add calendar buttons to conference session pages to easily save events to your calendar",
  "permissions": [],
  "host_permissions": [
    "https://aiconference.nl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aiconference.nl/session/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
